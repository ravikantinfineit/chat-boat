# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Opus 5 is the default. Use claude-sonnet-5 if per-message cost matters at volume.
CHAT_MODEL=claude-opus-5

# --- Postgres ----------------------------------------------------------------
DATABASE_URL=postgres://diamond:diamond@localhost:5432/diamond_chatbot
# Dev only. Use migrations in production.
DB_SYNCHRONIZE=true

# --- Redis / BullMQ ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------------------
PORT=3000
# Public origin of this service; shown in the admin panel as the webhook URL
# the client's ERP should POST stock/price changes to (spec 3.11).
PUBLIC_BASE_URL=http://localhost:3000
# Secret used to sign/verify the admin session + encrypt stored ERP API keys.
APP_SECRET=change-me-32-bytes-minimum-secret

# --- Mock ERP (apps/erp-mock) ------------------------------------------------
# Stand-in for the dealer's system, serving apps/erp-mock/data/diamonds.json.
ERP_MOCK_PORT=4010
ERP_MOCK_API_KEY=test-key
# ERP_MOCK_DATA_FILE=/absolute/path/to/diamonds.json

# --- Frontends ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
